<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.github.smolcan</groupId>
  <artifactId>ag-grid-jpa-adapter</artifactId>
  <version>1.2.3-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>ag-grid-jpa-adapter</name>
  <description>Adapter for AG-Grid using JPA Criteria API</description>
  <url>https://github.com/smolcan/ag-grid-jpa-adapter</url>

  <organization>
    <name>smolcan</name>
  </organization>
  <scm>
    <url>https://github.com/smolcan/ag-grid-jpa-adapter</url>
    <connection>scm:git:git://github.com/smolcan/ag-grid-jpa-adapter.git</connection>
    <developerConnection>scm:git:ssh://git@github.com:/smolcan/ag-grid-jpa-adapter.git</developerConnection>
    <tag>HEAD</tag>
  </scm>
  <issueManagement>
    <system>GitHub</system>
    <url>https://github.com/smolcan/ag-grid-jpa-adapter/issues</url>
  </issueManagement>
  <licenses>
    <license>
      <name>Apache 2</name>
      <url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>
  <developers>
    <developer>
      <id>smolcan</id>
      <name>Samuel Molčan</name>
      <email>samuel.molcan01@gmail.com</email>
    </developer>
  </developers>

  <properties>
    <lombok.version>1.18.46</lombok.version>
    <!-- the baseline the library compiles against; -Djpa=3.1 / -Djpa=3.2 swap it together with the providers -->
    <jakarta.persistence.version>3.0.0</jakarta.persistence.version>
    <!-- Hibernate 6.1.x is the last line implementing Jakarta Persistence 3.0 (6.2 targets 3.1) -->
    <hibernate.groupId>org.hibernate.orm</hibernate.groupId>
    <hibernate.artifactId>hibernate-core</hibernate.artifactId>
    <hibernate.version>6.1.7.Final</hibernate.version>
    <!-- EclipseLink 3.0.x implements Jakarta Persistence 3.0 (4.0 targets 3.1) -->
    <eclipselink.version>3.0.4</eclipselink.version>
    <!-- Eclipse Transformer for the javax jar and the jpa-2.2 tests; 1.0.0 needs Maven to run on Java 17, 0.5.0 runs on 11 -->
    <transformer.version>0.5.0</transformer.version>
    <!-- the library runs on Java 8, like the Jakarta Persistence 3.0 API it compiles against -->
    <maven.compiler.release>8</maven.compiler.release>
    <!-- the tests need Java 11: Hibernate 6 and EclipseLink 4 are Java 11 bytecode -->
    <maven.compiler.testRelease>11</maven.compiler.testRelease>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <!-- overwritten by jacoco prepare-agent; empty default keeps surefire's @{argLine} resolvable when jacoco is skipped -->
    <argLine />
  </properties>

  <dependencies>
    <dependency>
      <groupId>jakarta.persistence</groupId>
      <artifactId>jakarta.persistence-api</artifactId>
      <version>${jakarta.persistence.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <version>${lombok.version}</version>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.11.4</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>3.27.7</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- coordinates are properties: the Hibernate 5 line was published under other ones -->
      <groupId>${hibernate.groupId}</groupId>
      <artifactId>${hibernate.artifactId}</artifactId>
      <version>${hibernate.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- second JPA provider for the compatibility matrix; picked via -Dtest.jpa.provider=ECLIPSELINK -->
      <groupId>org.eclipse.persistence</groupId>
      <artifactId>org.eclipse.persistence.jpa</artifactId>
      <version>${eclipselink.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <version>2.3.232</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <version>42.7.13</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mariadb.jdbc</groupId>
      <artifactId>mariadb-java-client</artifactId>
      <version>3.5.10</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>postgresql</artifactId>
      <version>1.21.4</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>mariadb</artifactId>
      <version>1.21.4</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <version>9.7.0</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>mysql</artifactId>
      <version>1.21.4</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.microsoft.sqlserver</groupId>
      <artifactId>mssql-jdbc</artifactId>
      <version>12.10.2.jre11</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>mssqlserver</artifactId>
      <version>1.21.4</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.oracle.database.jdbc</groupId>
      <artifactId>ojdbc11</artifactId>
      <version>23.26.3.0.0</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>oracle-free</artifactId>
      <version>1.21.4</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <!-- Fixing version & activating "release" profile for those who use release plugin -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-release-plugin</artifactId>
        <version>3.1.1</version>
        <configuration>
          <autoVersionSubmodules>true</autoVersionSubmodules>
          <useReleaseProfile>false</useReleaseProfile>
          <!-- javax: every release also publishes the -javax.jar for JPA 2.2 -->
          <releaseProfiles>release,javax</releaseProfiles>
        </configuration>
      </plugin>
      
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.9.0</version>
        <configuration>
          <annotationProcessorPaths>
            <path>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
              <version>${lombok.version}</version>
            </path>
            <!-- generates the static metamodel (Trade_, ...) for test entities; no-op for main sources -->
            <path>
              <groupId>org.hibernate.orm</groupId>
              <artifactId>hibernate-jpamodelgen</artifactId>
              <!-- pinned apart from the test provider: the generated source works on every spec line,
                   and from Hibernate 7 this artifact is only a relocation stub -->
              <version>6.6.54.Final</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
        <configuration>
          <!-- byte-buddy experimental flag lets Hibernate run on JDKs newer than it knows -->
          <argLine>@{argLine} -Dnet.bytebuddy.experimental=true</argLine>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>0.8.13</version>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>test</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <configuration>
          <rules>
            <requireJavaVersion>
              <version>[11,)</version>
            </requireJavaVersion>
          </rules>
        </configuration>
        <version>3.3.0</version>
        <executions>
          <execution>
            <id>enforce-java-version</id>
            <phase>validate</phase>
            <goals>
              <goal>enforce</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <!-- test-only: the suite on JPA 2.2 (javax.persistence), on the bytecode the -javax.jar ships.
           Compiles as usual, then the Eclipse Transformer renames the classes and the test classes
           to javax before the tests run -->
      <id>jpa-2.2</id>
      <activation>
        <property>
          <name>jpa</name>
          <value>2.2</value>
        </property>
      </activation>
      <properties>
        <hibernate.groupId>org.hibernate</hibernate.groupId>
        <hibernate.artifactId>hibernate-core</hibernate.artifactId>
        <hibernate.version>5.6.15.Final</hibernate.version>
        <eclipselink.version>2.7.15</eclipselink.version>
      </properties>
      <build>
        <directory>${project.basedir}/target/jpa-2.2</directory>
        <testResources>
          <testResource>
            <directory>${project.basedir}/src/javax/test-resources</directory>
          </testResource>
        </testResources>
        <plugins>
          <plugin>
            <groupId>org.eclipse.transformer</groupId>
            <artifactId>transformer-maven-plugin</artifactId>
            <version>${transformer.version}</version>
            <configuration>
              <rules>
                <renames>
                  <rename>${project.basedir}/src/javax/renames.properties</rename>
                </renames>
              </rules>
            </configuration>
            <executions>
              <!-- both after test-compile: the test sources compile against the jakarta classes -->
              <execution>
                <id>javax-classes</id>
                <phase>process-test-classes</phase>
                <goals>
                  <goal>transform</goal>
                </goals>
                <configuration>
                  <transformDirectory>${project.build.outputDirectory}</transformDirectory>
                </configuration>
              </execution>
              <execution>
                <id>javax-test-classes</id>
                <phase>process-test-classes</phase>
                <goals>
                  <goal>transform</goal>
                </goals>
                <configuration>
                  <transformDirectory>${project.build.testOutputDirectory}</transformDirectory>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <configuration>
              <systemPropertyVariables>
                <!-- the same Hibernate 5.6 as in jpa-3.0-hibernate5, see the comment there -->
                <hibernate.criteria.literal_handling_mode>INLINE</hibernate.criteria.literal_handling_mode>
              </systemPropertyVariables>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
    <!-- test-only: run the suite on newer spec lines. Own build directory so classes compiled
         against one API never get reused against another. -->
    <profile>
      <!-- the Hibernate line a Java 8 user can run: 5.6 republished for the jakarta namespace,
           as Hibernate 6 needs Java 11 -->
      <id>jpa-3.0-hibernate5</id>
      <activation>
        <property>
          <name>jpa</name>
          <value>3.0-hibernate5</value>
        </property>
      </activation>
      <properties>
        <hibernate.groupId>org.hibernate</hibernate.groupId>
        <hibernate.artifactId>hibernate-core-jakarta</hibernate.artifactId>
        <hibernate.version>5.6.15.Final</hibernate.version>
      </properties>
      <build>
        <directory>${project.basedir}/target/jpa-3.0-hibernate5</directory>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <configuration>
              <systemPropertyVariables>
                <!-- by default Hibernate 5 inlines string literals in SELECT and GROUP BY but binds them in
                     ORDER BY, so sorting by a grouped CASE over strings orders by an expression the
                     database cannot match to the grouped one (Hibernate 6 refers to the select alias) -->
                <hibernate.criteria.literal_handling_mode>INLINE</hibernate.criteria.literal_handling_mode>
              </systemPropertyVariables>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>jpa-3.1</id>
      <activation>
        <property>
          <name>jpa</name>
          <value>3.1</value>
        </property>
      </activation>
      <properties>
        <jakarta.persistence.version>3.1.0</jakarta.persistence.version>
        <hibernate.version>6.6.54.Final</hibernate.version>
        <eclipselink.version>4.0.9</eclipselink.version>
        <!-- the 3.1 API jar is Java 11 bytecode -->
        <maven.compiler.release>11</maven.compiler.release>
      </properties>
      <build>
        <directory>${project.basedir}/target/jpa-3.1</directory>
      </build>
    </profile>
    <profile>
      <id>jpa-3.2</id>
      <activation>
        <property>
          <name>jpa</name>
          <value>3.2</value>
        </property>
      </activation>
      <properties>
        <jakarta.persistence.version>3.2.0</jakarta.persistence.version>
        <hibernate.version>7.4.14.Final</hibernate.version>
        <eclipselink.version>5.0.2</eclipselink.version>
        <!-- the 3.2 API jar and both providers are Java 17 bytecode -->
        <maven.compiler.release>17</maven.compiler.release>
        <maven.compiler.testRelease>17</maven.compiler.testRelease>
      </properties>
      <build>
        <directory>${project.basedir}/target/jpa-3.2</directory>
      </build>
    </profile>

    <profile>
      <!-- the same jar for JPA 2.2 (javax.persistence), attached with the "javax" classifier:
           ./mvnw package -Pjavax -->
      <id>javax</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.eclipse.transformer</groupId>
            <artifactId>transformer-maven-plugin</artifactId>
            <version>${transformer.version}</version>
            <executions>
              <execution>
                <id>javax-jar</id>
                <goals>
                  <goal>jar</goal>
                </goals>
                <configuration>
                  <artifact>
                    <groupId>${project.groupId}</groupId>
                    <artifactId>${project.artifactId}</artifactId>
                  </artifact>
                  <classifier>javax</classifier>
                  <rules>
                    <renames>
                      <rename>${project.basedir}/src/javax/renames.properties</rename>
                    </renames>
                  </rules>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>0.6.0</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <autoPublish>true</autoPublish>
            </configuration>
          </plugin>

          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-jar-plugin</artifactId>
            <version>3.4.1</version>
            <executions>
              <execution>
                <id>attach-sources</id>
                <phase>package</phase>
                <goals>
                  <goal>jar</goal>
                </goals>
                <configuration>
                  <classifier>sources</classifier>
                  <classesDirectory>${project.build.directory}/generated-sources/delombok</classesDirectory>
                </configuration>
              </execution>
            </executions>
          </plugin>

          <plugin>
            <!-- Delombok sources so javadoc can resolve Lombok-generated members (javadoc does not run annotation processors). -->
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok-maven-plugin</artifactId>
            <version>1.18.20.0</version>
            <configuration>
              <sourceDirectory>${project.basedir}/src/main/java</sourceDirectory>
              <addOutputDirectory>false</addOutputDirectory>
              <encoding>UTF-8</encoding>
            </configuration>
            <dependencies>
              <!-- Override the plugin's bundled Lombok with the JDK-compatible version. -->
              <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
              </dependency>
            </dependencies>
            <executions>
              <execution>
                <id>delombok</id>
                <phase>generate-sources</phase>
                <goals>
                  <goal>delombok</goal>
                </goals>
              </execution>
            </executions>
          </plugin>

          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <version>3.10.1</version>
            <configuration>
              <sourcepath>${project.build.directory}/generated-sources/delombok</sourcepath>
            </configuration>
            <executions>
              <execution>
                <id>attach-javadocs</id>
                <goals>
                  <goal>jar</goal>
                </goals>
              </execution>
            </executions>
          </plugin>

          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>3.2.4</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals>
                  <goal>sign</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
  
</project>
